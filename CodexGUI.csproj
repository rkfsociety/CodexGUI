<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Version>0.0.79</Version>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\codex-assistant.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Views\WorkspaceView.xaml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Scripts\Update-CodexGUI.ps1" Link="Update-CodexGUI.ps1" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Views\WorkspaceView.xaml" LogicalName="CodexGUI.Views.WorkspaceView.xaml" />
    <EmbeddedResource Include="Scripts\Update-CodexGUI.ps1" LogicalName="CodexGUI.Update-CodexGUI.ps1" />
    <EmbeddedResource Include="Scripts\CodexCliWorker.ps1" LogicalName="CodexGUI.CodexCliWorker.ps1" />
    <Resource Include="Assets\codex-assistant.ico" />
    <Content Include="Assets\codex-assistant.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
