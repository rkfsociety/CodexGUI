<Application x:Class="CodexGUI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Canvas" Color="#101113" />
    <SolidColorBrush x:Key="Sidebar" Color="#17181B" />
    <SolidColorBrush x:Key="Surface" Color="#1E2024" />
    <SolidColorBrush x:Key="SurfaceHover" Color="#27292E" />
    <SolidColorBrush x:Key="Line" Color="#2B2D32" />
    <SolidColorBrush x:Key="TextMain" Color="#F0F0F1" />
    <SolidColorBrush x:Key="TextMuted" Color="#9A9BA1" />
    <SolidColorBrush x:Key="TextFaint" Color="#6F7178" />
    <SolidColorBrush x:Key="Accent" Color="#E8E8EA" />
    <SolidColorBrush x:Key="Green" Color="#77C99B" />
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextMain}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource SurfaceHover}" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource TextMain}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="CaretBrush" Value="{StaticResource TextMain}" />
      <Setter Property="SelectionBrush" Value="#5A5E68" />
    </Style>
  </Application.Resources>
</Application>
