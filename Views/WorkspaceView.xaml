<Grid x:Name="Root"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      TextElement.FontSize="13" TextElement.Foreground="{StaticResource TextMain}" Background="#060D11" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
  <Grid.Resources>
    <SolidColorBrush x:Key="Canvas" Color="#070E12" />
    <SolidColorBrush x:Key="Sidebar" Color="#0B1419" />
    <SolidColorBrush x:Key="Surface" Color="#101C22" />
    <SolidColorBrush x:Key="SurfaceHover" Color="#193039" />
    <SolidColorBrush x:Key="Line" Color="#25404A" />
    <SolidColorBrush x:Key="TextMain" Color="#F1F3F5" />
    <SolidColorBrush x:Key="TextMuted" Color="#B0B5BE" />
    <SolidColorBrush x:Key="TextFaint" Color="#8D95A2" />
    <SolidColorBrush x:Key="Green" Color="#70E8CC" />
    <SolidColorBrush x:Key="AccentSoft" Color="#204139" />
    <Style x:Key="SidebarRailIconButton" TargetType="Button">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Margin" Value="0,3" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="10" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#26333D" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#33434F" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#203B37" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ComposerControlButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="BorderBrush" Value="#3B4049" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#2A4151" />
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#587286" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#1B2A36" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#70E8CC" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.55" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid.ColumnDefinitions>
    <ColumnDefinition Width="42" />
    <ColumnDefinition Width="280" />
    <ColumnDefinition Width="*" />
    <ColumnDefinition Width="0" />
  </Grid.ColumnDefinitions>

<Border Grid.ColumnSpan="4" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Background="#0A1318"><Grid Margin="20,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="✳" Foreground="{StaticResource Accent}" FontSize="30"/><TextBlock Text="Codex" FontWeight="SemiBold" FontSize="23" Margin="12,0,0,0" VerticalAlignment="Center"/><TextBlock x:Name="WorkspaceTagline" Text="Локальный ИИ-ассистент для разработчиков" Foreground="{StaticResource TextFaint}" FontSize="10" Margin="20,0,0,0" VerticalAlignment="Center"/></StackPanel><StackPanel WindowChrome.IsHitTestVisibleInChrome="True" x:Name="WorkspaceHeaderControls" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="30,0,0,0" VerticalAlignment="Center"><Button x:Name="WorkspaceProjectButton" BorderBrush="{StaticResource Line}" BorderThickness="1" ToolTip="Выбрать проект"><StackPanel Orientation="Horizontal"><TextBlock Text="▧  Проект   " Foreground="{StaticResource TextMuted}"/><TextBlock x:Name="WorkspaceProjectName" Text="CodexGUI" MaxWidth="150" TextTrimming="CharacterEllipsis"/><TextBlock Text="  ⌄"/></StackPanel></Button><Button x:Name="WorkspaceFolderButton" Content="▱" Margin="8,0" BorderBrush="{StaticResource Line}" BorderThickness="1" ToolTip="Открыть папку проекта"/><Button x:Name="WorkspaceBranchButton" ToolTip="Состояние Git" BorderBrush="{StaticResource Line}" BorderThickness="1"><TextBlock x:Name="WorkspaceBranch" Text="⑂  Git"/></Button><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0"><Ellipse Width="7" Height="7" Fill="{Binding Fill, ElementName=StatusDot}" Margin="0,0,8,0"/><TextBlock Text="{Binding Text, ElementName=HeaderStatus}" Foreground="{StaticResource Accent}" FontSize="11"/></StackPanel></StackPanel><Button WindowChrome.IsHitTestVisibleInChrome="True" Margin="0,0,18,0" Grid.Column="2" x:Name="WorkspaceSearchButton" Width="280" Content="⌕   Поиск по проекту…" Foreground="{StaticResource TextMuted}" BorderBrush="{StaticResource Line}" BorderThickness="1" VerticalAlignment="Center"/><UniformGrid WindowChrome.IsHitTestVisibleInChrome="True" Grid.Column="3" Columns="3" VerticalAlignment="Center"><Button x:Name="WindowMinimizeButton" Content="—" Width="42" ToolTip="Свернуть"/><Button x:Name="WindowMaximizeButton" Content="□" Width="42" ToolTip="Развернуть / восстановить"/><Button x:Name="WindowCloseButton" Content="×" Width="42" FontSize="19" ToolTip="Закрыть"/></UniformGrid></Grid></Border>
  <Border x:Name="SidebarPanel" Grid.Row="1" Grid.Column="1" Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
    <Grid Margin="12,10,12,10"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border CornerRadius="14" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="#0B151A" Padding="12"><DockPanel><DockPanel DockPanel.Dock="Top" Margin="0,0,0,10"><Button x:Name="RefreshRepositoryButton" Content="↻" DockPanel.Dock="Right" ToolTip="Обновить проект" Padding="4"/><TextBlock Text="▱   Структура проекта" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><TreeView x:Name="FileTree"  Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMain}" /></DockPanel></Border>
<Expander Grid.Row="1" Header="Проекты и история чатов" Foreground="{StaticResource TextMuted}" Margin="4,8"><StackPanel><DockPanel><Button x:Name="AddProjectButton" Content="＋ Проект" DockPanel.Dock="Right"/><TextBlock Text="Проекты"/></DockPanel><ScrollViewer MaxHeight="90"><StackPanel x:Name="ProjectList"/></ScrollViewer><DockPanel><Button x:Name="ArchivedChatsButton" Content="Архив" DockPanel.Dock="Right"/><TextBlock x:Name="ChatSectionLabel" Text="История чатов"/></DockPanel><ScrollViewer MaxHeight="130"><StackPanel x:Name="ChatList"/></ScrollViewer></StackPanel></Expander>
<Border Grid.Row="2" CornerRadius="14" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="#0B151A" Padding="12"><DockPanel><TextBlock DockPanel.Dock="Top" Text="✧   Карта проекта" FontWeight="SemiBold" Margin="0,0,0,12"/><UniformGrid DockPanel.Dock="Top" Columns="3" Margin="0,0,0,8"><Button x:Name="MapFilesButton" Content="Файлы" Background="#163B3A"/><Button x:Name="MapDependenciesButton" Content="Зависимости"/><Button x:Name="MapLayersButton" Content="Слои"/></UniformGrid><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"><Button x:Name="MapZoomInButton" Content="＋" ToolTip="Увеличить карту"/><Button x:Name="MapZoomOutButton" Content="−" ToolTip="Уменьшить карту"/><Button x:Name="MapResetButton" Content="⛶" ToolTip="Сбросить масштаб"/><Button x:Name="MapFullButton" Content="Открыть полный вид" FontSize="10"/></StackPanel><Viewbox Stretch="Uniform"><Canvas x:Name="ProjectMap" Width="300" Height="230" ClipToBounds="True"/></Viewbox></DockPanel></Border>
<Grid Grid.Row="3" Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="ProjectButton" HorizontalContentAlignment="Left"><TextBlock x:Name="ProjectPathShort" Text="Локальный проект" FontSize="10"/></Button><Border Grid.Column="1" x:Name="UpdateStatusPanel" Visibility="Collapsed"><Button x:Name="UpdateButton" IsEnabled="False"><Grid><Path x:Name="UpdateProgressArc"/><TextBlock x:Name="UpdateProgressLabel" Text="0%"/></Grid></Button></Border></Grid>
</Grid></Border>
  <Border Visibility="Collapsed" x:Name="SidebarIconRail" Grid.Row="1" Grid.Column="0" Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
    <DockPanel LastChildFill="True" Margin="4,12,4,10">
      <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Center">
        <Border Height="1" Background="{StaticResource Line}" Margin="4,5,4,8" />
        <Button x:Name="RailContextButton" Style="{StaticResource SidebarRailIconButton}" ToolTip="Данные и Git-изменения" AutomationProperties.Name="Данные и Git-изменения">
          <Path Width="18" Height="18" Stretch="Uniform" Stroke="{StaticResource TextMuted}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M5,2 V16 M5,6 H12 C15,6 15,9 15,11 V15 M12,12 L15,15 L18,12" />
        </Button>
        <Button x:Name="RailActionsButton" Style="{StaticResource SidebarRailIconButton}" ToolTip="Действия" AutomationProperties.Name="Действия">
          <Path Width="18" Height="18" Stretch="Uniform" Stroke="{StaticResource TextMuted}" StrokeThickness="1.5" StrokeLineJoin="Round" Data="M2,2 H8 V8 H2 Z M12,2 H18 V8 H12 Z M2,12 H8 V18 H2 Z M12,12 H18 V18 H12 Z" />
        </Button>
      </StackPanel>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel HorizontalAlignment="Center">
          <Button x:Name="ExpandSidebarButton" Style="{StaticResource SidebarRailIconButton}" Margin="0,2,0,7" Background="#252B30" ToolTip="Свернуть или развернуть список чатов" AutomationProperties.Name="Свернуть или развернуть список чатов">
            <Path Width="18" Height="18" Stretch="Uniform" Stroke="#E2E8EC" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M2,8 L10,2 L18,8 M4.5,7.5 V17 H8.5 V12 H11.5 V17 H15.5 V7.5" />
          </Button>
          <Button x:Name="RailNewChatButton" Style="{StaticResource SidebarRailIconButton}" ToolTip="Новый чат (Ctrl+K)" AutomationProperties.Name="Новый чат">
            <Path Width="18" Height="18" Stretch="Uniform" Stroke="{StaticResource TextMuted}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M3,3 H15 C16.7,3 18,4.3 18,6 V12 C18,13.7 16.7,15 15,15 H8 L4,18 V15 H3 C1.3,15 0,13.7 0,12 V6 C0,4.3 1.3,3 3,3 Z M9,6 V12 M6,9 H12" />
          </Button>
          <Button x:Name="RailSearchButton" Style="{StaticResource SidebarRailIconButton}" ToolTip="Поиск чатов (Ctrl+F)" AutomationProperties.Name="Поиск чатов">
            <Path Width="18" Height="18" Stretch="Uniform" Stroke="{StaticResource TextMuted}" StrokeThickness="1.6" StrokeStartLineCap="Round" Data="M12.5,12.5 L17,17 M14,8 A6,6 0 1 1 2,8 A6,6 0 1 1 14,8 Z" />
          </Button>
          <Button x:Name="RailActivityButton" Style="{StaticResource SidebarRailIconButton}" ToolTip="Активность" AutomationProperties.Name="Активность">
            <Grid Width="20" Height="20">
              <Path Width="18" Height="18" Stretch="Uniform" Stroke="{StaticResource TextMuted}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M10,2 A8,8 0 1 1 9.99,2 M10,5 V10 L14,12" />
              <Border x:Name="ActivityNotificationBadge" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="7" Background="#70E8CC" BorderBrush="{StaticResource Sidebar}" BorderThickness="1" Visibility="Collapsed">
                <TextBlock x:Name="ActivityNotificationCount" Text="0" FontSize="8" FontWeight="Bold" Foreground="#070E12" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Grid>
          </Button>
          <Button x:Name="RailAutomationsButton" Style="{StaticResource SidebarRailIconButton}" ToolTip="Расписания и результаты" AutomationProperties.Name="Расписания и результаты">
            <Path Width="18" Height="18" Stretch="Uniform" Stroke="{StaticResource TextMuted}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M3,4 H17 V17 H3 Z M6,2 V6 M14,2 V6 M3,8 H17 M6,11 H9 M6,14 H9 M13,11 L15,13 L13,15" />
          </Button>
          <Button x:Name="RailAgentsButton" Style="{StaticResource SidebarRailIconButton}" ToolTip="Субагенты текущего чата" AutomationProperties.Name="Субагенты текущего чата">
            <Path Width="18" Height="18" Stretch="Uniform" Stroke="{StaticResource TextMuted}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M4,3 V15 M4,7 H13 V4 M4,11 H13 V15 M13,4 H17 M13,15 H17" />
          </Button>
          <Button x:Name="RailExtensionsButton" Style="{StaticResource SidebarRailIconButton}" ToolTip="Плагины и скиллы" AutomationProperties.Name="Плагины и скиллы">
            <Path Width="18" Height="18" Stretch="Uniform" Stroke="{StaticResource TextMuted}" StrokeThickness="1.5" StrokeLineJoin="Round" Data="M2,4 H5 V16 H2 Z M7,3 H11 V17 H7 Z M13,5 H16 V18 H13 Z M3,7 H4 M8,6 H10 M14,8 H15" />
          </Button>
          <Button x:Name="RailMcpServersButton" Style="{StaticResource SidebarRailIconButton}" ToolTip="MCP-серверы" AutomationProperties.Name="MCP-серверы">
            <Path Width="18" Height="18" Stretch="Uniform" Stroke="{StaticResource TextMuted}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M10,2 V7 M10,11 V16 M2,9 H7 M13,9 H18 M4,4 L7.5,7.5 M12.5,12.5 L16,16 M16,4 L12.5,7.5 M7.5,12.5 L4,16 M10,7 A2,2 0 1 1 9.99,7 M10,11 A2,2 0 1 1 9.99,11" />
          </Button>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>

  <Grid x:Name="WorkspaceStage" Grid.Row="1" Grid.Column="2">
    <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{StaticResource Canvas}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <Grid Margin="30,0,28,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
          <TextBlock Text="РАБОЧЕЕ ПРОСТРАНСТВО" Foreground="{StaticResource TextFaint}" FontWeight="SemiBold" FontSize="10" Margin="0,0,0,5"/>
          <TextBlock x:Name="HeaderTitle" Text="Новая задача" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
            <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="{StaticResource Green}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBlock x:Name="HeaderStatus" Text="Готов" FontSize="11" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="TerminalButton" Padding="9,8" Foreground="{StaticResource TextMuted}" ToolTip="Открыть терминалы Codex"><TextBlock Text="&gt;_" FontFamily="Consolas" FontSize="13"/></Button>
          <Button x:Name="OpenFolderButton" Padding="9,8" Foreground="{StaticResource TextMuted}" ToolTip="Открыть папку проекта"><TextBlock Text="↗" FontSize="17"/></Button>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border x:Name="ChatOverviewCard" Grid.Row="0" Width="390" Height="62" HorizontalAlignment="Right" CornerRadius="14" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="18,12,28,7" Padding="12,8">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Button x:Name="ChatAttachmentsButton" Grid.Column="0" Padding="3,2" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" ToolTip="Показать все вложения текущего чата">
            <StackPanel>
              <DockPanel LastChildFill="True">
                <TextBlock x:Name="ChatAttachmentsCount" Text="0" DockPanel.Dock="Right" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="8,0,5,0"/>
                <TextBlock Text="▧  ВЛОЖЕНИЯ ЧАТА" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
              </DockPanel>
              <TextBlock x:Name="ChatAttachmentsPreview" Text="Нет прикреплённых файлов" Foreground="{StaticResource TextMain}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,5,3,0"/>
            </StackPanel>
          </Button>
          <Border Grid.Column="1" Background="{StaticResource Line}" Margin="10,2"/>
          <Button x:Name="ChatDiffButton" Grid.Column="2" Padding="8,2,1,2" ToolTip="Изменения в текущем коде, которые ещё не отправлены в upstream">
            <StackPanel>
              <TextBlock Text="НЕ ОТПРАВЛЕНО" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
              <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <TextBlock x:Name="GitAddedLines" Text="+—" Foreground="#89DCAD" FontWeight="SemiBold" FontSize="12" Margin="0,0,10,0"/>
                <TextBlock x:Name="GitRemovedLines" Text="−—" Foreground="#E89D9D" FontWeight="SemiBold" FontSize="12"/>
              </StackPanel>
            </StackPanel>
          </Button>
        </Grid>
      </Border>
      <ScrollViewer x:Name="ConversationScroll" Grid.Row="1" Margin="28,0,28,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="Conversation" MaxWidth="1040" HorizontalAlignment="Stretch" Margin="0,24,0,36"/>
      </ScrollViewer>

    </Grid>
  </Grid>
  <Border x:Name="ContextPanel" Grid.Row="1" Grid.Column="3" Background="Transparent" BorderBrush="{StaticResource Line}" BorderThickness="0" CornerRadius="14" Margin="0,10,12,12" Visibility="Visible">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid Margin="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="0" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <DockPanel Grid.Row="0">
        <Button x:Name="CloseContextButton" DockPanel.Dock="Right" Padding="5,2" Content="×" FontSize="16" Foreground="{StaticResource TextMuted}" />
        <TextBlock Text="Чат и репозиторий" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
      </DockPanel>
      <Border MinHeight="260" Grid.Row="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="13" Margin="0,9,0,0">
        <StackPanel>
          <TextBlock Text="ТЕКУЩАЯ ЦЕЛЬ" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid Width="48" Height="48" VerticalAlignment="Center"><Ellipse Stroke="#204A43" StrokeThickness="5" Width="40" Height="40"/><Path x:Name="GoalProgressArc" Stroke="{StaticResource Accent}" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Grid><Button x:Name="ThreadGoalButton" Grid.Column="1" MinHeight="70" Padding="11,0" Margin="12,0,0,12" Background="{StaticResource Surface}" Foreground="#D8E3E9" FontSize="12" IsEnabled="False" ToolTip="Просмотреть, задать или изменить цель текущего чата"><TextBlock x:Name="ThreadGoalLabel" Text="Поставить цель" MaxWidth="300" TextWrapping="Wrap" VerticalAlignment="Center"/></Button></Grid><DockPanel Margin="0,0,0,8"><Button x:Name="AddGoalStepButton" DockPanel.Dock="Right" Content="＋ Шаг" FontSize="10" ToolTip="Добавить локальный шаг цели"/><TextBlock x:Name="GoalStepCount" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Text="0/0"/></DockPanel><StackPanel x:Name="GoalSteps" Margin="0,0,0,10"/><Expander Header="Сведения о чате" FontSize="10" Foreground="{StaticResource TextMuted}"><StackPanel><TextBlock Text="ЧАТ" FontSize="9" Foreground="{StaticResource TextFaint}" FontWeight="SemiBold" />
          <TextBlock x:Name="ChatInfoTitle" Text="Новый чат" FontSize="12" Foreground="{StaticResource TextMain}" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" />
          <TextBlock x:Name="ChatInfoDetails" Text="Модель · Сообщений: 0" FontSize="10" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,3,0,0" />
          <TextBlock x:Name="ChatSessionInfo" Text="Сессия создастся при первом запросе" FontSize="9" Foreground="{StaticResource TextFaint}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
</StackPanel></Expander>        </StackPanel>
      </Border>
      <StackPanel Grid.Row="2" Visibility="Collapsed" Margin="1,10,1,9">
        <TextBlock Text="ПАПКА ПРОЕКТА" FontSize="9" Foreground="{StaticResource TextFaint}" FontWeight="SemiBold" />
        <TextBlock x:Name="FolderLabel" Text="—" FontSize="10" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,0" />
      </StackPanel>
      <Border x:Name="RepositoryCard" Visibility="Collapsed" Grid.Row="3" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="13" Margin="0,0,0,9"><Expander x:Name="RepositoryDetails" Header="Git · изменения проекта" FontSize="11">
        <StackPanel>
          <TextBlock Text="РЕПОЗИТОРИЙ" FontSize="9" Foreground="{StaticResource TextFaint}" FontWeight="SemiBold" />
          <TextBlock x:Name="RepositoryBranch" Text="Проверяю состояние…" FontSize="10" Foreground="{StaticResource TextMain}" TextWrapping="Wrap" Margin="0,5,0,0" />
          <TextBlock x:Name="RepositorySummary" Text="" FontSize="9" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,3,0,0" />
          <Button x:Name="InsertGitContextButton" Content="Git-контекст в запрос" HorizontalAlignment="Left" Padding="7,4" Margin="0,5,0,2" Foreground="{StaticResource Accent}" IsEnabled="False" ToolTip="Получить свежий Git-статус активной рабочей копии и вставить сводку в черновик без отправки" />
          <Button x:Name="ReviewChangesButton" Content="Проверить изменения" HorizontalAlignment="Left" Padding="7,4" Margin="0,4,0,2" Foreground="{StaticResource Accent}" Visibility="Collapsed" ToolTip="Проверить незакоммиченные изменения с помощью Codex App Server" />
          <Button x:Name="RepositoryRemoteButton" Content="Открыть origin ↗" HorizontalAlignment="Left" Padding="2,3" Foreground="{StaticResource Accent}" Visibility="Collapsed" ToolTip="Открыть удалённый репозиторий" />
          <WrapPanel Margin="0,4,0,0">
            <Button x:Name="StageAllChangesButton" Content="В индекс всё" Padding="7,4" Margin="0,0,5,0" Visibility="Collapsed" ToolTip="Добавить все незастейдженные изменения в индекс Git" />
            <Button x:Name="UnstageAllChangesButton" Content="Снять индекс" Padding="7,4" Visibility="Collapsed" ToolTip="Убрать все изменения из индекса, сохранив файлы" />
          </WrapPanel>
          <StackPanel x:Name="RepositoryCommitPanel" Margin="0,5,0,0" Visibility="Collapsed">
            <TextBlock Text="СООБЩЕНИЕ КОММИТА" FontSize="9" Foreground="{StaticResource TextFaint}" Margin="0,3,0,4" />
            <DockPanel>
              <Button x:Name="CommitStagedButton" DockPanel.Dock="Right" Content="Коммит" Padding="8,5" Margin="5,0,0,0" ToolTip="Зафиксировать только staged-изменения" />
              <TextBox x:Name="CommitMessageInput" Height="30" Padding="7,4" Background="#24272D" Foreground="#EAF3F6" BorderBrush="#435D6D" ToolTip="Сообщение коммита" />
            </DockPanel>
          </StackPanel>
          <Button x:Name="PushBranchButton" Content="Отправить ветку" HorizontalAlignment="Left" Padding="8,5" Margin="0,5,0,0" Visibility="Collapsed" ToolTip="Отправить текущую ветку в настроенный upstream без force-push" />
          <Button x:Name="CreatePullRequestButton" Content="Создать Pull Request" HorizontalAlignment="Left" Padding="8,5" Margin="0,4,0,0" Visibility="Collapsed" ToolTip="Создать Pull Request для уже отправленной GitHub-ветки через GitHub CLI" />
          <ScrollViewer MaxHeight="145" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="RepositoryChangesPanel" />
          </ScrollViewer>
        </StackPanel>
      </Expander></Border>
<StackPanel Grid.Row="4" Margin="0,6,0,0"><Border MinHeight="210" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="13"><StackPanel><TextBlock Text="КОНТЕКСТ И ПАМЯТЬ" Foreground="{StaticResource Accent}" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,8"/><StackPanel x:Name="WorkspaceContextList"/></StackPanel></Border><Border MinHeight="210" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="13" Margin="0,10,0,0"><StackPanel><TextBlock Text="БЫСТРЫЕ ИНСТРУМЕНТЫ" Foreground="{StaticResource Accent}" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,8"/><UniformGrid Columns="2"><Button x:Name="QuickFindButton" Content="⌕  Найти в коде" ToolTip="Подготовить запрос поиска" FontSize="12" Margin="3" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="#15232B" Padding="6,12"/><Button x:Name="QuickFileButton" Content="▧  Открыть файл" ToolTip="Просмотреть файл" FontSize="12" Margin="3" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="#15232B" Padding="6,12"/><Button x:Name="QuickTerminalButton" Content="›_  Запустить команду" ToolTip="Открыть терминал" FontSize="12" Margin="3" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="#15232B" Padding="6,12"/><Button x:Name="QuickDiffButton" Content="⑂  Изменения" ToolTip="Перейти к Git" FontSize="12" Margin="3" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="#15232B" Padding="6,12"/><Button x:Name="QuickCreateButton" Content="＋  Создать файл" ToolTip="Подготовить запрос создания файла" FontSize="12" Margin="3" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="#15232B" Padding="6,12"/><Button x:Name="QuickExplainButton" Content="▤  Объяснить код" ToolTip="Прикрепить файл к вопросу" FontSize="12" Margin="3" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="#15232B" Padding="6,12"/></UniformGrid></StackPanel></Border></StackPanel>
      <StackPanel Grid.Row="5" Margin="0,8,0,0">
        <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,9" />
        <TextBlock Text="Файлы и состояние Git выбранного проекта" FontSize="9" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" LineHeight="14" />
      </StackPanel>
    </Grid></ScrollViewer>
  </Border>
<Border x:Name="WorkspaceDock" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" CornerRadius="22" BorderBrush="#326C70" BorderThickness="1" Background="#0C1A20" Margin="140,0,140,8" Padding="18,12"><Grid x:Name="WorkspaceDockGrid"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><Button x:Name="WorkspaceChatsButton" Content="▤   Чат" HorizontalContentAlignment="Left" Background="#18343B" Margin="0,3" ToolTip="Открыть историю чатов"/><Button x:Name="WorkspaceAgentButton" Content="✧   Агент" HorizontalContentAlignment="Left" Margin="0,3" ToolTip="Субагенты текущего чата"/><Button x:Name="WorkspaceToolsButton" Content="▦   Инструменты" HorizontalContentAlignment="Left" Margin="0,3"/></StackPanel>      <StackPanel HorizontalAlignment="Stretch"  Grid.Column="1" Margin="8,0,0,0">
        <Border x:Name="PromptQueueBorder" Background="#181A1E" BorderBrush="{StaticResource Line}" BorderThickness="1,1,1,0" CornerRadius="12,12,0,0" Padding="10,5" Visibility="Collapsed">
          <StackPanel>
            <DockPanel><Button x:Name="ClearPromptQueueButton" DockPanel.Dock="Right" Content="Очистить" Padding="5,2" FontSize="10" Foreground="{StaticResource TextMuted}"/><TextBlock x:Name="PromptQueueLabel" Text="Очередь" FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/></DockPanel>
            <ScrollViewer MaxHeight="90" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="PromptQueueList"/></ScrollViewer>
          </StackPanel>
        </Border>
        <Border x:Name="ComposerBorder" Background="{StaticResource Surface}" BorderThickness="1" BorderBrush="#396B6C" CornerRadius="18" Padding="10,4,10,4">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="BorderBrush" Value="{StaticResource Line}" />
              <Setter Property="CornerRadius" Value="18" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Visibility, ElementName=PromptQueueBorder}" Value="Visible">
                  <Setter Property="CornerRadius" Value="0,0,18,18" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=PromptInput}" Value="True">
                  <Setter Property="BorderBrush" Value="#4B7668" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="26" ShadowDepth="7" Opacity="0.16" /></Border.Effect>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border x:Name="ComposerAttachmentsBorder" Grid.Row="0" Background="#181A1E" CornerRadius="10" Padding="7" Margin="0,0,0,9" Visibility="Collapsed">
              <ScrollViewer MaxHeight="72" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <WrapPanel x:Name="ComposerAttachmentsPanel" Orientation="Horizontal" />
              </ScrollViewer>
            </Border>
            <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="PromptInput" HorizontalAlignment="Stretch" TextAlignment="Left" MinHeight="42" MaxHeight="180" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Padding="4,7,4,10" FontSize="13" Foreground="{StaticResource TextFaint}" Language="ru-RU" SpellCheck.IsEnabled="False" Text="Опишите задачу или изменение проекта…" /><StackPanel x:Name="ComposerSettings" Grid.Column="1"><WrapPanel Margin="0,10,0,0">
                <Button x:Name="ModelButton" Style="{StaticResource ComposerControlButton}" Height="34" Padding="10,0" Margin="0,0,6,5" Background="{StaticResource Surface}" Foreground="#D8E3E9" ToolTip="Выбрать модель">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Модель" FontSize="10" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                    <TextBlock x:Name="ModelLabel" Text="gpt-6-luna" FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center" />
                    <Path Width="8" Height="5" Stretch="Fill" Margin="8,0,0,0" VerticalAlignment="Center" Stroke="{StaticResource TextMuted}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M0.8,0.8 L4,4.2 L7.2,0.8" />
                  </StackPanel>
                </Button>


                <Button x:Name="ModeButton" Style="{StaticResource ComposerControlButton}" Height="34" Padding="10,0" Margin="0,0,0,5" Background="{StaticResource Surface}" Foreground="#D8E3E9" ToolTip="Настроить доступ и подтверждения">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Width="14" Height="16" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center" Stroke="{Binding Foreground, ElementName=AccessModeLabel}" StrokeThickness="1.2" Fill="Transparent" StrokeLineJoin="Round" Data="M7,0.5 L13,2.5 V7.2 C13,10.6 10.4,13.2 7,15.5 C3.6,13.2 1,10.6 1,7.2 V2.5 Z" />
                    <TextBlock x:Name="AccessModeLabel" Text="Попросить подтверждение" FontSize="11" VerticalAlignment="Center" />
                    <Path Width="8" Height="5" Stretch="Fill" Margin="8,0,0,0" VerticalAlignment="Center" Stroke="{StaticResource TextMuted}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M0.8,0.8 L4,4.2 L7.2,0.8" />
                  </StackPanel>
                </Button>
              </WrapPanel></StackPanel></Grid>
            <Grid Grid.Row="2" Margin="0,4,0,0" MinHeight="42">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0"><WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="AddContextButton" Width="34" Height="34" Padding="0" Background="#2C3037" Foreground="{StaticResource TextMain}" ToolTip="Добавить файл в контекст"><TextBlock Text="＋" FontSize="19" /></Button>
                <Button x:Name="WorkspaceAttachButton" Content="@ Файл" FontSize="11"/><Button x:Name="WorkspaceContextButton" Content="# Контекст" FontSize="11"/><Button x:Name="WorkspaceWebButton" Content="◎ Веб-поиск" FontSize="11"/><Button x:Name="ActionsButton" Visibility="Collapsed" Content="Действия" Height="34" Padding="11,0" Margin="8,0,0,0" Background="{StaticResource Surface}" Foreground="#D8E3E9" FontSize="12" ToolTip="Вставить сохранённый шаблон в черновик" />
                <Button x:Name="ScreenshotButton" Height="34" Padding="11,0" Margin="8,0,0,0" Background="{StaticResource Surface}" Foreground="#D8E3E9" ToolTip="Выбрать область экрана и добавить снимок в контекст"><StackPanel Orientation="Horizontal"><TextBlock Text="▧" FontSize="14" Margin="0,0,7,0"/><TextBlock Text="Скриншот" FontSize="12"/></StackPanel></Button>
                <Button x:Name="SkillsButton" Content="Скиллы" Visibility="Collapsed" Height="34" Padding="11,0" Margin="8,0,0,0" Background="{StaticResource Surface}" Foreground="#D8E3E9" FontSize="12" ToolTip="Добавить скилл в запрос: imagegen, computer-use и другие"/>
              </WrapPanel></StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                <Grid Width="34" Height="34" Margin="0,0,8,0" ToolTip="Контекст текущего чата"><Ellipse Stroke="#435D6D" StrokeThickness="2.6"/><Path x:Name="ContextUsageArc" Stroke="#70E8CC" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><TextBlock x:Name="ContextPercent" Text="—" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                  <Button x:Name="FollowUpModeButton" Height="30" Padding="8,0" Margin="0,0,0,4" Background="#213341" Foreground="#C8D4E2" FontSize="10" Visibility="Collapsed" ToolTip="Выбрать, отправлять ли сообщение в текущий ход или поставить в очередь"/>
                  <Button x:Name="StopButton" Content="Остановить" Height="30" Padding="8,0" Background="#4A2A31" Foreground="#F2C5C8" FontSize="10" Visibility="Collapsed" ToolTip="Прервать текущий ход Codex"/>
                </StackPanel>
                <Button x:Name="SendButton" Width="110" Height="42" Padding="0" Background="#70E8CC" Foreground="#121D27" ToolTip="Отправить (Enter)"><TextBlock x:Name="SendButtonIcon" Text="↑" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" /></Button>
              </StackPanel>
            </Grid>
            <Border Grid.Row="3" Visibility="Collapsed" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="3,6,3,0" Margin="0,6,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="ЛИМИТЫ" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextFaint}" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock x:Name="UsageLimitsLabel" Grid.Column="1" Text="Загружаю лимиты…" FontSize="10" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="Лимиты аккаунта" />
              </Grid>
            </Border>
          </Grid>
        </Border>
        <TextBlock Text="Enter — отправить  ·  Ctrl+Enter — направить  ·  Shift+Enter — новая строка" Foreground="{StaticResource TextFaint}" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" />
      </StackPanel></Grid></Border>
</Grid>
