<Grid x:Name="Root"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#111214">
  <Grid.Resources>
    <SolidColorBrush x:Key="Canvas" Color="#111214" />
    <SolidColorBrush x:Key="Sidebar" Color="#17181B" />
    <SolidColorBrush x:Key="Surface" Color="#1D1F23" />
    <SolidColorBrush x:Key="SurfaceHover" Color="#292B30" />
    <SolidColorBrush x:Key="Line" Color="#292B30" />
    <SolidColorBrush x:Key="TextMain" Color="#F3F3F4" />
    <SolidColorBrush x:Key="TextMuted" Color="#A1A2A8" />
    <SolidColorBrush x:Key="TextFaint" Color="#777981" />
    <SolidColorBrush x:Key="Green" Color="#8BD2A8" />
    <SolidColorBrush x:Key="AccentSoft" Color="#282A2F" />
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextMain}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{StaticResource SurfaceHover}" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.72" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#55585F" />
      <Setter Property="Width" Value="8" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent" SnapsToDevicePixels="True">
              <Track x:Name="PART_Track"
                     Orientation="{TemplateBinding Orientation}"
                     IsDirectionReversed="False"
                     Minimum="{TemplateBinding Minimum}"
                     Maximum="{TemplateBinding Maximum}"
                     Value="{TemplateBinding Value}"
                     ViewportSize="{TemplateBinding ViewportSize}">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False" IsTabStop="False" Background="Transparent" BorderThickness="0" Opacity="0" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb MinHeight="26" MinWidth="26" Background="#55585F">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbFace" Background="{TemplateBinding Background}" CornerRadius="4" Margin="1" />
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbFace" Property="Background" Value="#858891" /></Trigger>
                          <Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbFace" Property="Background" Value="#A6A8AE" /></Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False" IsTabStop="False" Background="Transparent" BorderThickness="0" Opacity="0" />
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="Orientation" Value="Horizontal">
                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="8" />
              </Trigger>
              <Trigger Property="Orientation" Value="Vertical">
                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="True" />
                <Setter Property="Width" Value="8" />
                <Setter Property="Height" Value="Auto" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto" /><Setter Property="Height" Value="8" /></Trigger>
        <Trigger Property="Orientation" Value="Vertical"><Setter Property="Width" Value="8" /><Setter Property="Height" Value="Auto" /></Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Foreground" Value="{StaticResource TextMain}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="14"/><Setter Property="CaretBrush" Value="{StaticResource TextMain}"/><Setter Property="SelectionBrush" Value="#5A5E68"/></Style>
  </Grid.Resources>
  <Grid.ColumnDefinitions>
      <ColumnDefinition Width="264" />
    <ColumnDefinition Width="*" />
    <ColumnDefinition Width="0" />
  </Grid.ColumnDefinitions>

  <Border Grid.Column="0" Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
    <Grid Margin="16,16,14,16">
      <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="50"/><RowDefinition Height="42"/><RowDefinition Height="38"/><RowDefinition Height="132"/><RowDefinition Height="38"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="50"/></Grid.RowDefinitions>
      <DockPanel Grid.Row="0" LastChildFill="True">
        <Button x:Name="CollapseButton" DockPanel.Dock="Right" Width="34" Padding="0" Content="‹" FontSize="19" Foreground="{StaticResource TextMuted}" ToolTip="Свернуть боковую панель" />
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="25" Height="25" CornerRadius="8" Background="#EBEBED" Margin="0,0,9,0"><TextBlock Text="✳" Foreground="#17181B" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="Codex" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Text="⌄" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="8,1,0,0" VerticalAlignment="Center"/></StackPanel>
      </DockPanel>
      <Button x:Name="NewChatButton" Grid.Row="1" Margin="0,8,0,0" Background="#292B30" HorizontalContentAlignment="Left" Padding="12,8"><StackPanel Orientation="Horizontal"><TextBlock Text="＋" FontSize="16" Margin="0,0,10,0"/><TextBlock Text="Новый чат" VerticalAlignment="Center"/><TextBlock Text="Ctrl K" Foreground="{StaticResource TextFaint}" FontSize="10" Margin="77,3,0,0"/></StackPanel></Button>
      <Button x:Name="SearchButton" Grid.Row="2" Margin="0,3,0,0" HorizontalContentAlignment="Left" Foreground="{StaticResource TextMuted}"><StackPanel Orientation="Horizontal"><TextBlock Text="⌕" FontSize="20" Margin="1,0,10,0"/><TextBlock Text="Поиск чатов" VerticalAlignment="Center"/><TextBlock Text="Ctrl F" Foreground="{StaticResource TextFaint}" FontSize="10" Margin="63,3,0,0"/></StackPanel></Button>
      <Grid Grid.Row="3" Margin="10,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="ПРОЕКТЫ" Foreground="{StaticResource TextFaint}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="AddProjectButton" Grid.Column="1" Width="24" Height="24" Padding="0" Content="＋" FontSize="15" Foreground="{StaticResource TextMuted}" ToolTip="Создать проект или добавить папку"/></Grid>
      <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" Margin="0,2,0,4"><StackPanel x:Name="ProjectList" /></ScrollViewer>
      <Grid Grid.Row="5" Margin="10,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ChatSectionLabel" Text="ЧАТЫ" Foreground="{StaticResource TextFaint}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="ArchivedChatsButton" Grid.Column="1" Padding="5,2" Content="Архив" FontSize="10" Foreground="{StaticResource TextMuted}" ToolTip="Открыть архив чатов"/></Grid>
      <ScrollViewer Grid.Row="6" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0"><StackPanel x:Name="ChatList" /></ScrollViewer>
      <Border Grid.Row="7" Background="#202125" BorderBrush="#2B2D32" BorderThickness="1" CornerRadius="10" Padding="13" Margin="0,4,0,11"><StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,7"><Ellipse Width="7" Height="7" Fill="{StaticResource Green}" Margin="0,0,8,0"/><TextBlock x:Name="ConnectionStatus" Text="Codex CLI готов" FontSize="11" FontWeight="SemiBold" /></StackPanel><TextBlock x:Name="ConnectionDetail" Text="Запросы выполняются в выбранной папке." FontSize="10" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" LineHeight="16" /></StackPanel></Border>
      <Button x:Name="ProjectButton" Grid.Row="8" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal"><Border Width="27" Height="27" CornerRadius="14" Background="#34363C" Margin="0,0,9,0"><TextBlock Text="R" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="Текущий проект" FontSize="11"/><TextBlock x:Name="ProjectPathShort" Text="Локальный проект" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/></StackPanel><TextBlock Text="···" FontSize="16" Foreground="{StaticResource TextMuted}" Margin="35,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
    </Grid>
  </Border>

  <Grid Grid.Column="1">
    <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Grid.Row="0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Background="{StaticResource Canvas}"><Grid Margin="26,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="HeaderTitle" Text="Новая задача" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="⌄" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="8,1,0,0" VerticalAlignment="Center"/><Border Background="#202125" BorderBrush="#2B2D32" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="14,0,0,0"><StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="{StaticResource Green}" Margin="0,0,6,0"/><TextBlock x:Name="HeaderStatus" Text="Готов" FontSize="10" Foreground="{StaticResource TextMuted}"/></StackPanel></Border></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="UpdateButton" Margin="0,0,6,0" Padding="10,7" Background="Transparent" Foreground="{StaticResource TextMuted}" ToolTip="Проверить наличие обновлений"><StackPanel Orientation="Horizontal"><TextBlock Text="⟳" FontSize="15" Margin="0,0,6,0"/><TextBlock x:Name="UpdateButtonLabel" Text="Проверить обновления" FontSize="11"/></StackPanel></Button><Button x:Name="ContextButton" Padding="10,7" Foreground="{StaticResource TextMuted}" ToolTip="Данные чата, репозитория и файлы"><StackPanel Orientation="Horizontal"><TextBlock Text="▤" Margin="0,0,7,0"/><TextBlock Text="Данные" FontSize="11"/></StackPanel></Button><Button x:Name="OpenFolderButton" Padding="9,6" Foreground="{StaticResource TextMuted}" ToolTip="Открыть папку проекта"><TextBlock Text="↗" FontSize="16"/></Button></StackPanel></Grid></Border>
    <Grid Grid.Row="1">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <ScrollViewer x:Name="ConversationScroll" Grid.Row="0" Margin="32,0,32,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="Conversation" MaxWidth="810" HorizontalAlignment="Stretch" Margin="0,34,0,24"/>
      </ScrollViewer>
      <StackPanel HorizontalAlignment="Stretch" MaxWidth="850" Grid.Row="1" Margin="32,0,32,17">
        <Border x:Name="ComposerBorder" Background="#1D1F23" BorderBrush="#3A3C42" BorderThickness="1" CornerRadius="18" Padding="17,14,15,12">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border x:Name="PromptQueueBorder" Grid.Row="0" Background="#25272C" CornerRadius="9" Padding="9,7" Margin="0,0,0,7" Visibility="Collapsed">
              <StackPanel>
                <DockPanel Margin="0,0,0,4"><Button x:Name="ClearPromptQueueButton" DockPanel.Dock="Right" Content="Очистить" Padding="4,1" FontSize="9" Foreground="{StaticResource TextMuted}"/><TextBlock x:Name="PromptQueueLabel" Text="В ОЧЕРЕДИ" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextFaint}" VerticalAlignment="Center"/></DockPanel>
                <ScrollViewer MaxHeight="88" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="PromptQueueList"/></ScrollViewer>
              </StackPanel>
            </Border>
            <TextBox x:Name="PromptInput" Grid.Row="1" HorizontalAlignment="Stretch" TextAlignment="Left" MinHeight="54" MaxHeight="150" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Padding="3,5,3,9" FontSize="14" Foreground="#DCDDE0" Text="Спросите Codex о задаче или попросите изменить проект…" />
            <Grid Grid.Row="2" Margin="0,7,0,0" MinHeight="36">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="AddContextButton" Width="32" Height="32" Padding="0" Background="#292B30" Foreground="{StaticResource TextMuted}" ToolTip="Добавить файл в контекст"><TextBlock Text="＋" FontSize="18" /></Button>
                <Button x:Name="ScreenshotButton" Height="32" Padding="9,0" Margin="7,0,0,0" Background="#27292E" Foreground="#D5D6D9" ToolTip="Выбрать область экрана и добавить снимок в контекст"><StackPanel Orientation="Horizontal"><TextBlock Text="▧" FontSize="13" Margin="0,0,6,0"/><TextBlock Text="Скриншот" FontSize="11"/></StackPanel></Button>
                <Button x:Name="ModelButton" Height="32" Padding="9,0" Margin="7,0,0,0" Background="#27292E" Foreground="#D5D6D9" ToolTip="Выбрать модель"><StackPanel Orientation="Horizontal"><TextBlock Text="Модель" FontSize="10" Foreground="{StaticResource TextMuted}"/><TextBlock x:Name="ModelLabel" Text="gpt-6-luna" FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0"/><TextBlock Text="⌄" Margin="6,0,0,0" Foreground="{StaticResource TextFaint}"/></StackPanel></Button>
                <Button x:Name="EffortButton" Height="32" Padding="9,0" Margin="5,0,0,0" Background="#27292E" Foreground="#D5D6D9" ToolTip="Выбрать уровень усилий"><StackPanel Orientation="Horizontal"><TextBlock Text="Усилия" FontSize="10" Foreground="{StaticResource TextMuted}"/><TextBlock x:Name="EffortLabel" Text="Высокие" FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0"/><TextBlock Text="⌄" Margin="6,0,0,0" Foreground="{StaticResource TextFaint}"/></StackPanel></Button>
                <Button x:Name="ModeButton" Height="32" Padding="9,0" Margin="5,0,0,0" Background="#27292E" Foreground="#C4C5C9" ToolTip="Настроить доступ и подтверждения"><StackPanel Orientation="Horizontal"><Path Width="13" Height="15" Margin="0,0,7,0" Stroke="#B4B5BA" StrokeThickness="1.2" Fill="Transparent" Data="M6.5,0.5 L12,2.5 V7.1 C12,10.2 9.7,12.7 6.5,14.5 C3.3,12.7 1,10.2 1,7.1 V2.5 Z"/><TextBlock x:Name="AccessModeLabel" Text="Попросить подтверждение" FontSize="10"/><TextBlock Text="⌄" Margin="7,0,0,0" Foreground="{StaticResource TextFaint}"/></StackPanel></Button>
              </WrapPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <Grid Width="34" Height="34" Margin="0,0,8,0" ToolTip="Контекст текущего чата"><Ellipse Stroke="#3B3D42" StrokeThickness="2.6"/><Path x:Name="ContextUsageArc" Stroke="#77C99B" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><TextBlock x:Name="ContextPercent" Text="—" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                <Border Background="#25272C" CornerRadius="6" Padding="8,5" Margin="0,0,9,0" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="{StaticResource Green}" Margin="0,0,6,0"/><TextBlock Text="CLI" FontSize="10" Foreground="{StaticResource TextMuted}"/></StackPanel></Border>
                <Button x:Name="SendButton" Width="36" Height="36" Padding="0" Background="#F0F0F1" Foreground="#17181B" ToolTip="Отправить (Enter)"><TextBlock x:Name="SendButtonIcon" Text="↑" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" /></Button>
              </StackPanel>
            </Grid>
            <Border Grid.Row="3" BorderBrush="#303238" BorderThickness="0,1,0,0" Padding="3,8,3,0" Margin="0,8,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="ЛИМИТЫ" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextFaint}" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock x:Name="UsageLimitsLabel" Grid.Column="1" Text="Загружаю лимиты Codex…" FontSize="10" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="Лимиты аккаунта Codex" />
              </Grid>
            </Border>
          </Grid>
        </Border>
        <TextBlock Text="Codex использует настройки и вход вашей локальной установки." Foreground="{StaticResource TextFaint}" FontSize="10" HorizontalAlignment="Center" Margin="0,9,0,0" />
      </StackPanel>
    </Grid>
  </Grid>
  <Border x:Name="ContextPanel" Grid.Column="2" Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Visibility="Collapsed">
    <Grid Margin="15,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="32" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <DockPanel Grid.Row="0">
        <Button x:Name="CloseContextButton" DockPanel.Dock="Right" Padding="5,2" Content="×" FontSize="16" Foreground="{StaticResource TextMuted}" />
        <TextBlock Text="Чат и репозиторий" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
      </DockPanel>
      <Border Grid.Row="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,9,0,0">
        <StackPanel>
          <TextBlock Text="ЧАТ" FontSize="9" Foreground="{StaticResource TextFaint}" FontWeight="SemiBold" />
          <TextBlock x:Name="ChatInfoTitle" Text="Новый чат" FontSize="12" Foreground="{StaticResource TextMain}" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" />
          <TextBlock x:Name="ChatInfoDetails" Text="Модель · Сообщений: 0" FontSize="10" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,3,0,0" />
          <TextBlock x:Name="ChatSessionInfo" Text="Сессия создастся при первом запросе" FontSize="9" Foreground="{StaticResource TextFaint}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
        </StackPanel>
      </Border>
      <StackPanel Grid.Row="2" Margin="1,10,1,9">
        <TextBlock Text="ПАПКА ПРОЕКТА" FontSize="9" Foreground="{StaticResource TextFaint}" FontWeight="SemiBold" />
        <TextBlock x:Name="FolderLabel" Text="—" FontSize="10" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,0" />
      </StackPanel>
      <Border Grid.Row="3" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,9">
        <StackPanel>
          <TextBlock Text="РЕПОЗИТОРИЙ" FontSize="9" Foreground="{StaticResource TextFaint}" FontWeight="SemiBold" />
          <TextBlock x:Name="RepositoryBranch" Text="Проверяю состояние…" FontSize="10" Foreground="{StaticResource TextMain}" TextWrapping="Wrap" Margin="0,5,0,0" />
          <TextBlock x:Name="RepositorySummary" Text="" FontSize="9" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,3,0,0" />
          <Button x:Name="RepositoryRemoteButton" Content="Открыть origin ↗" HorizontalAlignment="Left" Padding="2,3" Foreground="{StaticResource Accent}" Visibility="Collapsed" ToolTip="Открыть удалённый репозиторий" />
          <ScrollViewer MaxHeight="145" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="RepositoryChangesPanel" />
          </ScrollViewer>
        </StackPanel>
      </Border>
      <Grid Grid.Row="4">
        <Grid.RowDefinitions>
          <RowDefinition Height="28" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0">
          <Button x:Name="RefreshRepositoryButton" DockPanel.Dock="Right" Padding="5,2" Content="↻" FontSize="14" Foreground="{StaticResource TextMuted}" ToolTip="Обновить сведения о репозитории" />
          <TextBlock Text="ФАЙЛЫ" FontSize="9" Foreground="{StaticResource TextFaint}" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>
        <TreeView x:Name="FileTree" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMain}" />
      </Grid>
      <StackPanel Grid.Row="5" Margin="0,8,0,0">
        <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,9" />
        <TextBlock Text="Сохраните XAML, чтобы обновить интерфейс на лету." FontSize="9" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" LineHeight="14" />
      </StackPanel>
    </Grid>
  </Border>
</Grid>
