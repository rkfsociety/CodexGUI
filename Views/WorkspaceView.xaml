<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="Root" TextElement.FontSize="13" TextElement.Foreground="{StaticResource TextMain}" Background="#060D11" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale">
  <Grid.Resources>
    <SolidColorBrush x:Key="Canvas" Color="#050B0F" />
    <SolidColorBrush x:Key="Sidebar" Color="#0010181E" />
    <LinearGradientBrush x:Key="Surface" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#F00F1A20" Offset="0" />
      <GradientStop Color="#F0081116" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SurfaceHover" Color="#193039" />
    <SolidColorBrush x:Key="Line" Color="#263D47" />
    <SolidColorBrush x:Key="TextMain" Color="#E8EFF5" />
    <SolidColorBrush x:Key="TextMuted" Color="#9AADBB" />
    <SolidColorBrush x:Key="TextFaint" Color="#718391" />
    <SolidColorBrush x:Key="Green" Color="#70E8CC" />
    <SolidColorBrush x:Key="AccentSoft" Color="#204139" />
    <Style x:Key="SidebarRailIconButton" TargetType="Button">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Margin" Value="0,3" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="10" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#26333D" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#33434F" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#203B37" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ComposerControlButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="BorderBrush" Value="#3B4049" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#2A4151" />
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#587286" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#1B2A36" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#70E8CC" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.55" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="GoalStepCheckBox" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border x:Name="Chrome" Width="18" Height="18" CornerRadius="3" Background="#0C171D" BorderBrush="#748E9C" BorderThickness="1" VerticalAlignment="Center">
                <Path x:Name="Mark" Visibility="Collapsed" Data="M3,8 L6.5,11.5 L13,4" Stroke="#163B36" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
              </Border>
              <ContentPresenter Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#7CE6CC" />
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#7CE6CC" />
                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#93FBE1" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#1A2B34" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#1A2B34" />
    <Style TargetType="TreeViewItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Foreground" Value="{StaticResource TextMain}" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TreeViewItem">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="22" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <ToggleButton x:Name="Expander" Width="14" Height="18" Focusable="False" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                      <Path x:Name="Chevron" Width="5" Height="8" Stretch="Fill" Data="M1,1 L4,4 L1,7" Stroke="#9BB3C2" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5" />
                    </Grid>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Chevron" Property="RenderTransform">
                          <Setter.Value>
                            <RotateTransform Angle="90" />
                          </Setter.Value>
                        </Setter>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <Border x:Name="Selection" Grid.Column="1" Height="22" Background="Transparent" CornerRadius="4" Margin="-1000,0,0,0" Padding="1004,0,0,0">
                <ContentPresenter x:Name="PART_Header" ContentSource="Header" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
              </Border>
              <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsExpanded" Value="False">
                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
              </Trigger>
              <Trigger Property="HasItems" Value="False">
                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Selection" Property="Background" Value="#1A2B34" />
                <Setter Property="Foreground" Value="#CDE5EF" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#CDE5EF" />
    <Style x:Key="ComposerTabButton" TargetType="Button">
      <Setter Property="Foreground" Value="#DCE8F1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Path x:Name="Chrome" Data="M14,1 H162 Q171,1 169,9 L163,29 Q161,35 154,35 H7 Q-1,35 1,27 L7,9 Q9,1 14,1 Z" Stretch="Fill" Fill="{TemplateBinding Background}" Stroke="Transparent" StrokeThickness="0.8" />
              <Path x:Name="Hover" Data="M14,1 H162 Q171,1 169,9 L163,29 Q161,35 154,35 H7 Q-1,35 1,27 L7,9 Q9,1 14,1 Z" Stretch="Fill" Fill="#B3FFE9" Opacity="0" IsHitTestVisible="False" />
              <Path x:Name="NeonEdge" Data="M14,1 Q9,1 7,9 L1,27 Q-1,35 7,35" Stretch="Fill" HorizontalAlignment="Left" Width="14" Stroke="#76F8D7" StrokeThickness="2" Visibility="Collapsed" IsHitTestVisible="False">
                <Path.Effect>
                  <DropShadowEffect Color="#46E2BD" BlurRadius="12" ShadowDepth="0" Opacity="0.65" />
                </Path.Effect>
              </Path>
              <ContentPresenter Margin="16,0,9,0" HorizontalAlignment="Left" VerticalAlignment="Center" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="Tag" Value="Selected">
                <Setter TargetName="NeonEdge" Property="Visibility" Value="Visible" />
                <Setter TargetName="Chrome" Property="Stroke" Value="#284A50" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Hover" Property="Opacity" Value="0.07" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Chrome" Property="Stroke" Value="#72EDD2" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Hover" Property="Opacity" Value="0.12" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ComposerIconButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Path x:Name="Chrome" Data="M9,1 H33 Q40,1 40,8 L41,30 Q42,37 34,37 H8 Q1,37 1,30 L3,8 Q4,1 9,1 Z" Stretch="Fill" Fill="{TemplateBinding Background}" Stroke="#293F4B" StrokeThickness="1" />
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Stroke" Value="#4B7C7D" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Chrome" Property="Stroke" Value="#79EBD0" />
                <Setter TargetName="Chrome" Property="Effect">
                  <Setter.Value>
                    <DropShadowEffect Color="#4CE2BE" BlurRadius="10" ShadowDepth="0" Opacity="0.3" />
                  </Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.8" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Grid.Resources>
  <Grid.RowDefinitions>
    <RowDefinition Height="68" />
    <RowDefinition Height="*" />
    <RowDefinition Height="Auto" />
  </Grid.RowDefinitions>
  <Grid.ColumnDefinitions>
    <ColumnDefinition Width="42" />
    <ColumnDefinition Width="280" />
    <ColumnDefinition Width="*" />
    <ColumnDefinition Width="0" />
  </Grid.ColumnDefinitions>
  <Border Grid.ColumnSpan="4" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#060B0E" Offset="0" />
        <GradientStop Color="#060B0E" Offset="0.28" />
        <GradientStop Color="#080E11" Offset="0.63" />
        <GradientStop Color="#070B0F" Offset="1" />
      </LinearGradientBrush>
    </Border.Background>
    <Grid Margin="25,0,20,0" x:Name="WorkspaceHeaderGrid">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="425" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="48" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Width="32" Height="34" CornerRadius="6" BorderBrush="#63D5BC" BorderThickness="1.2" Background="#122B29" VerticalAlignment="Center">
          <Path Data="M12,2 V22 M2,12 H22 M5,5 L19,19 M5,19 L19,5" Width="27" Height="27" Stretch="Uniform" Stroke="{StaticResource Accent}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="Codex" FontWeight="SemiBold" FontSize="26" Margin="14,0,0,0" VerticalAlignment="Center" />
        <TextBlock x:Name="WorkspaceTagline" Text="Локальный ИИ-ассистент для разработчиков" Foreground="{StaticResource TextFaint}" FontSize="12" Margin="17,0,0,0" VerticalAlignment="Center" />
      </StackPanel>
      <StackPanel WindowChrome.IsHitTestVisibleInChrome="True" x:Name="WorkspaceHeaderControls" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="30,0,0,0" VerticalAlignment="Center">
        <Button x:Name="WorkspaceProjectButton" BorderBrush="{StaticResource Line}" BorderThickness="1" ToolTip="Выбрать проект" Width="196" Height="38">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="▧  Проект   " Foreground="{StaticResource TextMuted}" x:Name="WorkspaceProjectPrefix" />
            <TextBlock x:Name="WorkspaceProjectName" Text="CodexGUI" MaxWidth="100" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="  ⌄" />
          </StackPanel>
        </Button>
        <Button x:Name="WorkspaceFolderButton" Content="▱" Margin="12,0" BorderBrush="{StaticResource Line}" BorderThickness="1" ToolTip="Открыть папку проекта" Width="40" Height="38" />
        <Button x:Name="WorkspaceBranchButton" ToolTip="Состояние Git" BorderBrush="{StaticResource Line}" BorderThickness="1" Width="104" Height="38">
          <TextBlock x:Name="WorkspaceBranch" Text="⑂  Git" />
        </Button>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0" x:Name="WorkspaceAgentStatus">
          <Ellipse Width="7" Height="7" Fill="{Binding Fill, ElementName=StatusDot}" Margin="0,0,8,0" />
          <TextBlock Text="{Binding Text, ElementName=HeaderStatus}" Foreground="{StaticResource Accent}" FontSize="11" />
        </StackPanel>
      </StackPanel>
      <Border x:Name="UpdateStatusPanel" Grid.Column="2" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
        <Button x:Name="UpdateButton" Width="40" Height="40" Padding="0" IsEnabled="False" Opacity="1" ToolTip="Загрузка обновления">
          <Grid Width="36" Height="36">
            <Ellipse Width="30" Height="30" Stroke="#29443D" StrokeThickness="2" />
            <Path x:Name="UpdateProgressArc" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="#92E5C7" StrokeThickness="2" />
            <TextBlock x:Name="UpdateProgressLabel" Text="↓" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#D1F9E8" />
          </Grid>
        </Button>
      </Border>
      <Button WindowChrome.IsHitTestVisibleInChrome="True" Margin="0,0,49,0" Grid.Column="3" x:Name="WorkspaceSearchButton" Width="304" Foreground="{StaticResource TextMuted}" BorderBrush="{StaticResource Line}" BorderThickness="1" VerticalAlignment="Center" Height="38" HorizontalContentAlignment="Stretch" ToolTip="Поиск по проекту (Ctrl+K)">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Path Width="16" Height="16" Stretch="Uniform" Stroke="#9CB0BF" StrokeThickness="1.5" Data="M16,16 L22,22 M19,10 A9,9 0 1 1 1,10 A9,9 0 1 1 19,10 Z" VerticalAlignment="Center" HorizontalAlignment="Left" />
          <TextBlock Grid.Column="1" Text="Поиск по проекту..." FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <Border Grid.Column="2" CornerRadius="4" Background="#17232A" Padding="5,3">
            <TextBlock Text="Ctrl + K" FontSize="10" />
          </Border>
        </Grid>
      </Button>
      <UniformGrid WindowChrome.IsHitTestVisibleInChrome="True" Grid.Column="4" Columns="3" VerticalAlignment="Center" Margin="0,0,-12,0">
        <Button x:Name="WindowMinimizeButton" Content="—" Width="46" ToolTip="Свернуть" />
        <Button x:Name="WindowMaximizeButton" Content="□" Width="46" ToolTip="Развернуть / восстановить" FontSize="18" />
        <Button x:Name="WindowCloseButton" Content="×" Width="46" FontSize="18" ToolTip="Закрыть" />
      </UniformGrid>
    </Grid>
  </Border>
  <Border x:Name="SidebarPanel" Grid.Row="1" Grid.Column="1" Background="Transparent" BorderBrush="{StaticResource Line}" BorderThickness="0" Grid.RowSpan="2" Margin="0,0,0,122">
    <Grid Margin="16,12,0,12">
      <Grid.RowDefinitions>
        <RowDefinition Height="48.6*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="51.4*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Border CornerRadius="13" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="{StaticResource Surface}" Padding="0" x:Name="ProjectStructureCard">
        <DockPanel>
          <Border Height="46" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" DockPanel.Dock="Top">
            <Grid Margin="14,0,12,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path Data="M2,6 H10 L12,9 H22 V21 H2 Z M2,6 V3 H9 L12,6 H20 V9" Width="18" Height="18" Stretch="Uniform" Stroke="{StaticResource Accent}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" Margin="0,0,13,0" />
                <TextBlock Text="Структура проекта" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>
              <Button x:Name="RefreshRepositoryButton" Content="⋮" DockPanel.Dock="Right" ToolTip="Действия проекта" Padding="4" FontSize="18" Grid.Column="1" />
            </Grid>
          </Border>
          <TreeView x:Name="FileTree" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMain}" Margin="10,5,6,10" />
        </DockPanel>
      </Border>
      <Expander Grid.Row="1" Header="Проекты и история чатов" Foreground="{StaticResource TextMuted}" Margin="4,8" Visibility="Collapsed">
        <StackPanel>
          <DockPanel>
            <Button x:Name="AddProjectButton" Content="＋ Проект" DockPanel.Dock="Right" />
            <TextBlock Text="Проекты" />
          </DockPanel>
          <ScrollViewer MaxHeight="90">
            <StackPanel x:Name="ProjectList" />
          </ScrollViewer>
          <DockPanel>
            <Button x:Name="ArchivedChatsButton" Content="Архив" DockPanel.Dock="Right" />
            <TextBlock x:Name="ChatSectionLabel" Text="История чатов" />
          </DockPanel>
          <ScrollViewer MaxHeight="130">
            <StackPanel x:Name="ChatList" />
          </ScrollViewer>
        </StackPanel>
      </Expander>
      <Border Grid.Row="2" CornerRadius="13" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="{StaticResource Surface}" Padding="0" Margin="0,10,0,0" x:Name="ProjectMapCard">
        <DockPanel>
          <Border Height="46" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" DockPanel.Dock="Top">
            <Grid Margin="14,0,12,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path Data="M4,3 V10 H11 V17 H20 M4,10 H20 V4 M1,1 H7 V6 H1 Z M17,1 H23 V6 H17 Z M8,15 H14 V21 H8 Z M17,15 H23 V21 H17 Z" Width="18" Height="18" Stretch="Uniform" Stroke="{StaticResource Accent}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" Margin="0,0,13,0" />
                <TextBlock Text="Карта проекта" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>
            </Grid>
          </Border>
          <Border DockPanel.Dock="Top" Margin="12,6,10,0" CornerRadius="8" Background="#0B171D" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <UniformGrid DockPanel.Dock="Top" Columns="3" Margin="3" Height="34">
              <Button x:Name="MapFilesButton" Content="Файлы" Background="#163B3A" FontSize="12" Padding="5,2" />
              <Button x:Name="MapDependenciesButton" Content="Зависимости" FontSize="12" Padding="5,2" />
              <Button x:Name="MapLayersButton" Content="Слои" FontSize="12" Padding="5,2" />
            </UniformGrid>
          </Border>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="10,4,10,12">
            <Button x:Name="MapZoomInButton" Content="＋" ToolTip="Увеличить карту" Width="34" Height="34" Padding="0" Margin="3,0" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="#111E26" />
            <Button x:Name="MapZoomOutButton" Content="−" ToolTip="Уменьшить карту" Width="34" Height="34" Padding="0" Margin="3,0" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="#111E26" />
            <Button x:Name="MapResetButton" Content="⛶" ToolTip="Сбросить масштаб" Width="34" Height="34" Padding="0" Margin="3,0" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="#111E26" />
            <Button x:Name="MapFullButton" Content="Открыть полный вид" FontSize="11" Margin="50,0,0,0" Padding="6,4" />
          </StackPanel>
          <Viewbox Stretch="Uniform" Margin="10,7,10,0">
            <Canvas x:Name="ProjectMap" Width="300" Height="230" Background="#0A1318" ClipToBounds="True" />
          </Viewbox>
        </DockPanel>
      </Border>
      <Grid Grid.Row="3" Margin="0,4,0,0" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button x:Name="ProjectButton" HorizontalContentAlignment="Left">
          <TextBlock x:Name="ProjectPathShort" Text="Локальный проект" FontSize="10" />
        </Button>
      </Grid>
    </Grid>
  </Border>
  <Border Visibility="Collapsed" x:Name="SidebarIconRail" Grid.Row="1" Grid.Column="0" Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
    <DockPanel LastChildFill="True" Margin="4,12,4,10">
      <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Center">
        <Border Height="1" Background="{StaticResource Line}" Margin="4,5,4,8" />
        <Button x:Name="RailContextButton" Style="{StaticResource SidebarRailIconButton}" ToolTip="Данные и Git-изменения" AutomationProperties.Name="Данные и Git-изменения">
          <Path Width="18" Height="18" Stretch="Uniform" Stroke="{StaticResource TextMuted}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M5,2 V16 M5,6 H12 C15,6 15,9 15,11 V15 M12,12 L15,15 L18,12" />
        </Button>
        <Button x:Name="RailActionsButton" Style="{StaticResource SidebarRailIconButton}" ToolTip="Действия" AutomationProperties.Name="Действия">
          <Path Width="18" Height="18" Stretch="Uniform" Stroke="{StaticResource TextMuted}" StrokeThickness="1.5" StrokeLineJoin="Round" Data="M2,2 H8 V8 H2 Z M12,2 H18 V8 H12 Z M2,12 H8 V18 H2 Z M12,12 H18 V18 H12 Z" />
        </Button>
      </StackPanel>
