<Grid x:Name="Root"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      TextElement.Foreground="{StaticResource TextMain}" Background="#0E151D" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
  <Grid.Resources>
    <SolidColorBrush x:Key="Canvas" Color="#0B1117" />
    <SolidColorBrush x:Key="Sidebar" Color="#101820" />
    <SolidColorBrush x:Key="Surface" Color="#16212B" />
    <SolidColorBrush x:Key="SurfaceHover" Color="#20303D" />
    <SolidColorBrush x:Key="Line" Color="#2A3946" />
    <SolidColorBrush x:Key="TextMain" Color="#ECF2F5" />
    <SolidColorBrush x:Key="TextMuted" Color="#A7B5C0" />
    <SolidColorBrush x:Key="TextFaint" Color="#8494A2" />
    <SolidColorBrush x:Key="Green" Color="#92E5C7" />
    <SolidColorBrush x:Key="AccentSoft" Color="#204139" />
    <Style x:Key="ComposerDropdownButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="BorderBrush" Value="#344B5B" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#2A4151" />
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#587286" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#1B2A36" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#92E5C7" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.55" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#55585F" />
      <Setter Property="Width" Value="8" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent" SnapsToDevicePixels="True">
              <Track x:Name="PART_Track"
                     Orientation="{TemplateBinding Orientation}"
                     IsDirectionReversed="False"
                     Minimum="{TemplateBinding Minimum}"
                     Maximum="{TemplateBinding Maximum}"
                     Value="{TemplateBinding Value}"
                     ViewportSize="{TemplateBinding ViewportSize}">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False" IsTabStop="False" Background="Transparent" BorderThickness="0" Opacity="0" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb MinHeight="6" MinWidth="6" Background="#55585F">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbFace" Background="{TemplateBinding Background}" CornerRadius="4" Margin="1" />
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbFace" Property="Background" Value="#858891" /></Trigger>
                          <Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbFace" Property="Background" Value="#A6A8AE" /></Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False" IsTabStop="False" Background="Transparent" BorderThickness="0" Opacity="0" />
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="Orientation" Value="Horizontal">
                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="8" />
              </Trigger>
              <Trigger Property="Orientation" Value="Vertical">
                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="True" />
                <Setter Property="Width" Value="8" />
                <Setter Property="Height" Value="Auto" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto" /><Setter Property="Height" Value="8" /></Trigger>
        <Trigger Property="Orientation" Value="Vertical"><Setter Property="Width" Value="8" /><Setter Property="Height" Value="Auto" /></Trigger>
      </Style.Triggers>
    </Style>
  </Grid.Resources>
  <Grid.ColumnDefinitions>
      <ColumnDefinition Width="250" />
    <ColumnDefinition Width="*" />
    <ColumnDefinition Width="0" />
  </Grid.ColumnDefinitions>

  <Border x:Name="SidebarPanel" Grid.Column="0" Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
    <Grid Margin="16,20,16,16">
      <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="52"/><RowDefinition Height="44"/><RowDefinition Height="40"/><RowDefinition Height="*" MaxHeight="132"/><RowDefinition Height="38"/><RowDefinition Height="3*" MinHeight="60"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="50"/></Grid.RowDefinitions>
      <DockPanel Grid.Row="0" LastChildFill="True">
        <Button x:Name="CollapseButton" DockPanel.Dock="Right" Width="34" Padding="0" Content="‹" FontSize="19" Foreground="{StaticResource TextMuted}" ToolTip="Свернуть боковую панель" />
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="29" Height="29" CornerRadius="9" Background="#92E5C7" Margin="0,0,9,0"><TextBlock Text="✳" Foreground="#121D27" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="Codex" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
      </DockPanel>
      <Button x:Name="NewChatButton" Grid.Row="1" Margin="0,8,0,0" Background="#204139" Foreground="{StaticResource Accent}" HorizontalContentAlignment="Stretch" Padding="12,8"><DockPanel><TextBlock Text="Ctrl K" DockPanel.Dock="Right" Foreground="{StaticResource TextMuted}" FontSize="10" VerticalAlignment="Center"/><TextBlock Text="＋" FontSize="18" Margin="0,0,10,0"/><TextBlock Text="Новый чат" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel></Button>
      <Button x:Name="SearchButton" Grid.Row="2" Margin="0,3,0,0" HorizontalContentAlignment="Stretch" Foreground="{StaticResource TextMuted}"><DockPanel><TextBlock Text="Ctrl F" DockPanel.Dock="Right" Foreground="{StaticResource TextFaint}" FontSize="10" VerticalAlignment="Center"/><TextBlock Text="⌕" FontSize="20" Margin="1,0,10,0"/><TextBlock Text="Поиск чатов" VerticalAlignment="Center"/></DockPanel></Button>
      <Grid Grid.Row="3" Margin="10,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="ВАШИ ПРОЕКТЫ" Foreground="{StaticResource TextFaint}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="AddProjectButton" Grid.Column="1" Width="24" Height="24" Padding="0" Content="＋" FontSize="15" Foreground="{StaticResource TextMuted}" ToolTip="Создать проект или добавить папку"/></Grid>
      <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" Margin="0,2,0,4"><StackPanel x:Name="ProjectList" /></ScrollViewer>
      <Grid Grid.Row="5" Margin="10,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ChatSectionLabel" Text="ИСТОРИЯ ЧАТОВ" Foreground="{StaticResource TextFaint}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="ArchivedChatsButton" Grid.Column="1" Padding="5,2" Content="Архив" FontSize="10" Foreground="{StaticResource TextMuted}" ToolTip="Открыть архив чатов"/></Grid>
      <ScrollViewer Grid.Row="6" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0"><StackPanel x:Name="ChatList" /></ScrollViewer>
      <StackPanel Grid.Row="7"><Button x:Name="ActivityButton" Content="Активность" HorizontalContentAlignment="Left" Padding="12,7" Margin="0,4,0,0" Foreground="{StaticResource TextMuted}" ToolTip="Активные чаты, запросы на подтверждение и непрочитанные ответы"/><Button x:Name="AutomationsButton" Content="Расписания и результаты" HorizontalContentAlignment="Left" Padding="12,7" Margin="0,0,0,0" Foreground="{StaticResource TextMuted}" ToolTip="Локальные расписания Codex и очередь результатов на проверку"/><Button x:Name="AgentsButton" Content="Субагенты текущего чата" HorizontalContentAlignment="Left" Padding="12,7" Margin="0,0,0,0" Foreground="{StaticResource TextMuted}" ToolTip="Список вызванных субагентов, их состояние и переход к полной истории"/><Button x:Name="PluginsButton" Content="Плагины и скиллы" HorizontalContentAlignment="Left" Padding="12,7" Margin="0,0,0,0" Foreground="{StaticResource TextMuted}" ToolTip="Плагины Codex, imagegen, computer-use и все доступные скиллы"/><Button x:Name="McpServersButton" Content="MCP-серверы" HorizontalContentAlignment="Left" Padding="12,7" Margin="0,0,0,7" Foreground="{StaticResource TextMuted}" ToolTip="Состояние серверов из общего профиля Codex; проверка может запускать их процессы"/><Border Background="#1B2935" BorderBrush="#314454" BorderThickness="1" CornerRadius="10" Padding="13" Margin="0,4,0,11"><StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,7"><Ellipse Width="7" Height="7" Fill="{StaticResource Green}" Margin="0,0,8,0"/><TextBlock x:Name="ConnectionStatus" Text="Codex готов" FontSize="11" FontWeight="SemiBold" /></StackPanel><TextBlock x:Name="ConnectionDetail" Text="Запросы выполняются в выбранной папке." FontSize="10" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" LineHeight="16" /></StackPanel></Border></StackPanel>
      <Border x:Name="UpdateStatusPanel" Grid.Row="8" Visibility="Collapsed" Background="#1A302E" BorderBrush="#365C53" BorderThickness="1" CornerRadius="13" Padding="10,9" Margin="0,2,0,10">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Button x:Name="UpdateButton" Width="46" Height="46" Padding="0" Background="Transparent" Foreground="{StaticResource Accent}" Opacity="1" IsEnabled="False" ToolTip="Дождитесь окончания загрузки обновления" AutomationProperties.Name="Прогресс загрузки обновления" HorizontalAlignment="Left">
            <Grid Width="46" Height="46">
              <Ellipse Width="39" Height="39" Stroke="#416257" StrokeThickness="3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <Path x:Name="UpdateProgressArc" Width="46" Height="46" Stretch="None" Stroke="#92E5C7" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <TextBlock x:Name="UpdateProgressLabel" Text="0%" FontSize="10" FontWeight="SemiBold" Foreground="#D1F9E8" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
            </Grid>
          </Button>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
            <TextBlock x:Name="UpdateStatusTitle" Text="Доступно обновление" FontSize="11" FontWeight="SemiBold" Foreground="#E7F8EF" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="UpdateStatusDetail" Text="Подготовка загрузки…" FontSize="10" Foreground="#A6CBBE" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="14" MaxHeight="42"/>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="9"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="ProjectButton" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal"><Border Width="27" Height="27" CornerRadius="14" Background="#34363C" Margin="0,0,9,0"><TextBlock Text="⌘" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="Текущий проект" FontSize="11"/><TextBlock x:Name="ProjectPathShort" Text="Локальный проект" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/></StackPanel><TextBlock Text="···" FontSize="16" Foreground="{StaticResource TextMuted}" Margin="35,0,0,0" VerticalAlignment="Center"/></StackPanel></Button></Grid>
    </Grid>
  </Border>
  <Border x:Name="CollapsedSidebarRail" Grid.Column="0" Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Visibility="Collapsed">
    <Button x:Name="ExpandSidebarButton" Width="32" Height="34" Margin="0,24,0,0" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Top" Background="#1B2935" Foreground="{StaticResource TextMuted}" ToolTip="Показать боковую панель" AutomationProperties.Name="Показать боковую панель">
      <Path Width="8" Height="14" Stretch="Fill" Stroke="{StaticResource TextMuted}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M1,1 L6,7 L1,13" />
    </Button>
  </Border>

  <Grid Grid.Column="1">
    <Grid.RowDefinitions><RowDefinition Height="86"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{StaticResource Canvas}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <Grid Margin="30,0,28,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
          <TextBlock Text="РАБОЧЕЕ ПРОСТРАНСТВО  /  ЧАТ" Foreground="{StaticResource TextFaint}" FontWeight="SemiBold" FontSize="10" Margin="0,0,0,5"/>
          <TextBlock x:Name="HeaderTitle" Text="Новая задача" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
            <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="{StaticResource Green}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBlock x:Name="HeaderStatus" Text="Готов" FontSize="11" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="ContextButton" Padding="9,8" Background="{StaticResource Surface}" Margin="0,0,5,0" ToolTip="Данные чата и репозитория"><StackPanel Orientation="Horizontal"><TextBlock Text="▤" FontSize="14" Margin="0,0,6,0"/><TextBlock Text="Данные" FontSize="11"/></StackPanel></Button>
          <Button x:Name="TerminalButton" Padding="9,8" Foreground="{StaticResource TextMuted}" ToolTip="Открыть терминалы Codex"><TextBlock Text="&gt;_" FontFamily="Consolas" FontSize="13"/></Button>
          <Button x:Name="OpenFolderButton" Padding="9,8" Foreground="{StaticResource TextMuted}" ToolTip="Открыть папку проекта"><TextBlock Text="↗" FontSize="17"/></Button>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border x:Name="ChatOverviewCard" Grid.Row="0" Width="390" Height="62" HorizontalAlignment="Right" CornerRadius="14" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="18,12,28,7" Padding="12,8">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Button x:Name="ChatAttachmentsButton" Grid.Column="0" Padding="3,2" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" ToolTip="Показать все вложения текущего чата">
            <StackPanel>
              <DockPanel LastChildFill="True">
                <TextBlock x:Name="ChatAttachmentsCount" Text="0" DockPanel.Dock="Right" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="8,0,5,0"/>
                <TextBlock Text="▧  ВЛОЖЕНИЯ ЧАТА" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
              </DockPanel>
              <TextBlock x:Name="ChatAttachmentsPreview" Text="Нет прикреплённых файлов" Foreground="{StaticResource TextMain}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,5,3,0"/>
            </StackPanel>
          </Button>
          <Border Grid.Column="1" Background="{StaticResource Line}" Margin="10,2"/>
          <Button x:Name="ChatDiffButton" Grid.Column="2" Padding="8,2,1,2" ToolTip="Изменения в текущем коде, которые ещё не отправлены в upstream">
            <StackPanel>
              <TextBlock Text="НЕ ОТПРАВЛЕНО" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
              <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <TextBlock x:Name="GitAddedLines" Text="+—" Foreground="#89DCAD" FontWeight="SemiBold" FontSize="12" Margin="0,0,10,0"/>
                <TextBlock x:Name="GitRemovedLines" Text="−—" Foreground="#E89D9D" FontWeight="SemiBold" FontSize="12"/>
              </StackPanel>
            </StackPanel>
          </Button>
        </Grid>
      </Border>
      <ScrollViewer x:Name="ConversationScroll" Grid.Row="1" Margin="28,0,28,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="Conversation" MaxWidth="1040" HorizontalAlignment="Stretch" Margin="0,24,0,36"/>
      </ScrollViewer>
      <StackPanel HorizontalAlignment="Stretch" MaxWidth="1020" Grid.Row="2" Margin="28,0,28,22">
        <Border x:Name="ComposerBorder" Background="{StaticResource Surface}" BorderThickness="1" CornerRadius="18" Padding="22,18,22,16">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="BorderBrush" Value="{StaticResource Line}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=PromptInput}" Value="True">
                  <Setter Property="BorderBrush" Value="#4B7668" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="26" ShadowDepth="7" Opacity="0.16" /></Border.Effect>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border x:Name="PromptQueueBorder" Grid.Row="0" Background="#1B2935" CornerRadius="11" Padding="11,8" Margin="0,0,0,9" Visibility="Collapsed">
              <StackPanel>
                <DockPanel Margin="0,0,0,5"><Button x:Name="ClearPromptQueueButton" DockPanel.Dock="Right" Content="Очистить" Padding="6,3" FontSize="10" Foreground="{StaticResource TextMuted}"/><TextBlock x:Name="PromptQueueLabel" Text="В ОЧЕРЕДИ" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/></DockPanel>
                <ScrollViewer MaxHeight="88" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="PromptQueueList"/></ScrollViewer>
              </StackPanel>
            </Border>
            <Border x:Name="ComposerAttachmentsBorder" Grid.Row="1" Background="#111B24" CornerRadius="10" Padding="7" Margin="0,0,0,9" Visibility="Collapsed">
              <ScrollViewer MaxHeight="72" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <WrapPanel x:Name="ComposerAttachmentsPanel" Orientation="Horizontal" />
              </ScrollViewer>
            </Border>
            <TextBox x:Name="PromptInput" Grid.Row="2" HorizontalAlignment="Stretch" TextAlignment="Left" MinHeight="76" MaxHeight="180" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Padding="4,9,4,12" FontSize="16" Foreground="{StaticResource TextFaint}" Language="ru-RU" SpellCheck.IsEnabled="True" Text="Спросите Codex о задаче или попросите изменить проект…" />
            <Grid Grid.Row="3" Margin="0,10,0,0" MinHeight="42">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0"><WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="AddContextButton" Width="34" Height="34" Padding="0" Background="#22333F" Foreground="{StaticResource TextMain}" ToolTip="Добавить файл в контекст"><TextBlock Text="＋" FontSize="19" /></Button>
                <Button x:Name="ActionsButton" Content="Действия" Height="34" Padding="11,0" Margin="8,0,0,0" Background="{StaticResource Surface}" Foreground="#D8E3E9" FontSize="12" ToolTip="Вставить сохранённый шаблон в черновик" />
                <Button x:Name="ScreenshotButton" Height="34" Padding="11,0" Margin="8,0,0,0" Background="{StaticResource Surface}" Foreground="#D8E3E9" ToolTip="Выбрать область экрана и добавить снимок в контекст"><StackPanel Orientation="Horizontal"><TextBlock Text="▧" FontSize="14" Margin="0,0,7,0"/><TextBlock Text="Скриншот" FontSize="12"/></StackPanel></Button>
                <Button x:Name="SkillsButton" Content="Скиллы" Height="34" Padding="11,0" Margin="8,0,0,0" Background="{StaticResource Surface}" Foreground="#D8E3E9" FontSize="12" ToolTip="Добавить скилл в запрос: imagegen, computer-use и другие"/><Button x:Name="ThreadGoalButton" Content="Цель" Height="34" Padding="11,0" Margin="8,0,0,0" Background="{StaticResource Surface}" Foreground="#D8E3E9" FontSize="12" IsEnabled="False" ToolTip="Управлять сохранённой целью текущего чата"/>
              </WrapPanel><WrapPanel Margin="0,10,0,0">
                <Button x:Name="ModelButton" Style="{StaticResource ComposerDropdownButton}" Height="34" Padding="10,0" Margin="0,0,6,5" Background="{StaticResource Surface}" Foreground="#D8E3E9" ToolTip="Выбрать модель"><StackPanel Orientation="Horizontal"><TextBlock Text="Модель" FontSize="11" Foreground="{StaticResource TextMuted}"/><TextBlock x:Name="ModelLabel" Text="gpt-6-luna" FontSize="12" FontWeight="SemiBold" Margin="7,0,0,0"/><Path Width="9" Height="6" Stretch="Fill" Margin="10,0,0,0" Stroke="{StaticResource TextMuted}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M0.8,0.8 L4.5,4.8 L8.2,0.8"/></StackPanel></Button>
                <Button x:Name="EffortButton" Style="{StaticResource ComposerDropdownButton}" Height="34" Padding="10,0" Margin="0,0,6,5" Background="{StaticResource Surface}" Foreground="#D8E3E9" ToolTip="Выбрать уровень усилий"><StackPanel Orientation="Horizontal"><TextBlock Text="Усилия" FontSize="11" Foreground="{StaticResource TextMuted}"/><TextBlock x:Name="EffortLabel" Text="Высокие" FontSize="12" FontWeight="SemiBold" Margin="7,0,0,0"/><Path Width="9" Height="6" Stretch="Fill" Margin="10,0,0,0" Stroke="{StaticResource TextMuted}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M0.8,0.8 L4.5,4.8 L8.2,0.8"/></StackPanel></Button>
                <Button x:Name="WorktreeButton" Height="34" Padding="11,0" Margin="0,0,6,5" Background="{StaticResource Surface}" Foreground="#D8E3E9" ToolTip="Вести этот чат в отдельном Git worktree через Codex CLI"><StackPanel Orientation="Horizontal"><TextBlock Text="⑂" FontSize="16" Margin="0,0,7,0"/><TextBlock x:Name="WorktreeLabel" Text="Рабочая копия" FontSize="11"/></StackPanel></Button>
                <Button x:Name="ModeButton" Style="{StaticResource ComposerDropdownButton}" Height="34" Padding="10,0" Margin="0,0,0,5" Background="{StaticResource Surface}" Foreground="#D8E3E9" ToolTip="Настроить доступ и подтверждения"><StackPanel Orientation="Horizontal"><Path Width="13" Height="15" Margin="0,0,8,0" Stroke="#A7B5C0" StrokeThickness="1.2" Fill="Transparent" Data="M6.5,0.5 L12,2.5 V7.1 C12,10.2 9.7,12.7 6.5,14.5 C3.3,12.7 1,10.2 1,7.1 V2.5 Z"/><TextBlock x:Name="AccessModeLabel" Text="Попросить подтверждение" FontSize="11"/><Path Width="9" Height="6" Stretch="Fill" Margin="10,0,0,0" Stroke="{StaticResource TextMuted}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M0.8,0.8 L4.5,4.8 L8.2,0.8"/></StackPanel></Button>
              </WrapPanel></StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                <Grid Width="34" Height="34" Margin="0,0,8,0" ToolTip="Контекст текущего чата"><Ellipse Stroke="#435D6D" StrokeThickness="2.6"/><Path x:Name="ContextUsageArc" Stroke="#92E5C7" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><TextBlock x:Name="ContextPercent" Text="—" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                <Border Background="#213341" CornerRadius="6" Padding="8,5" Margin="0,0,9,0" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="{StaticResource Green}" Margin="0,0,6,0"/><TextBlock Text="Codex" FontSize="10" Foreground="{StaticResource TextMuted}"/></StackPanel></Border>
                <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                  <Button x:Name="FollowUpModeButton" Height="30" Padding="8,0" Margin="0,0,0,4" Background="#213341" Foreground="#C8D4E2" FontSize="10" Visibility="Collapsed" ToolTip="Выбрать, отправлять ли сообщение в текущий ход или поставить в очередь"/>
                  <Button x:Name="StopButton" Content="Остановить" Height="30" Padding="8,0" Background="#4A2A31" Foreground="#F2C5C8" FontSize="10" Visibility="Collapsed" ToolTip="Прервать текущий ход Codex"/>
                </StackPanel>
                <Button x:Name="SendButton" Width="42" Height="42" Padding="0" Background="#92E5C7" Foreground="#121D27" ToolTip="Отправить (Enter)"><TextBlock x:Name="SendButtonIcon" Text="↑" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" /></Button>
              </StackPanel>
            </Grid>
            <Border Grid.Row="4" BorderBrush="#314454" BorderThickness="0,1,0,0" Padding="3,8,3,0" Margin="0,8,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="ЛИМИТЫ" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextFaint}" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock x:Name="UsageLimitsLabel" Grid.Column="1" Text="Загружаю лимиты Codex…" FontSize="10" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="Лимиты аккаунта Codex" />
              </Grid>
            </Border>
          </Grid>
        </Border>
        <TextBlock Text="Enter — отправить   ·   Shift + Enter — новая строка" Foreground="{StaticResource TextFaint}" FontSize="11" HorizontalAlignment="Center" Margin="0,10,0,0" />
      </StackPanel>
    </Grid>
  </Grid>
  <Border x:Name="ContextPanel" Grid.Column="2" Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Visibility="Collapsed">
    <Grid Margin="15,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="32" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <DockPanel Grid.Row="0">
        <Button x:Name="CloseContextButton" DockPanel.Dock="Right" Padding="5,2" Content="×" FontSize="16" Foreground="{StaticResource TextMuted}" />
        <TextBlock Text="Чат и репозиторий" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
      </DockPanel>
      <Border Grid.Row="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="13" Margin="0,9,0,0">
        <StackPanel>
          <TextBlock Text="ЧАТ" FontSize="9" Foreground="{StaticResource TextFaint}" FontWeight="SemiBold" />
          <TextBlock x:Name="ChatInfoTitle" Text="Новый чат" FontSize="12" Foreground="{StaticResource TextMain}" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" />
          <TextBlock x:Name="ChatInfoDetails" Text="Модель · Сообщений: 0" FontSize="10" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,3,0,0" />
          <TextBlock x:Name="ChatSessionInfo" Text="Сессия создастся при первом запросе" FontSize="9" Foreground="{StaticResource TextFaint}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
        </StackPanel>
      </Border>
      <StackPanel Grid.Row="2" Margin="1,10,1,9">
        <TextBlock Text="ПАПКА ПРОЕКТА" FontSize="9" Foreground="{StaticResource TextFaint}" FontWeight="SemiBold" />
        <TextBlock x:Name="FolderLabel" Text="—" FontSize="10" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,0" />
      </StackPanel>
      <Border Grid.Row="3" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="13" Margin="0,0,0,9">
        <StackPanel>
          <TextBlock Text="РЕПОЗИТОРИЙ" FontSize="9" Foreground="{StaticResource TextFaint}" FontWeight="SemiBold" />
          <TextBlock x:Name="RepositoryBranch" Text="Проверяю состояние…" FontSize="10" Foreground="{StaticResource TextMain}" TextWrapping="Wrap" Margin="0,5,0,0" />
          <TextBlock x:Name="RepositorySummary" Text="" FontSize="9" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,3,0,0" />
          <Button x:Name="ReviewChangesButton" Content="Проверить изменения" HorizontalAlignment="Left" Padding="7,4" Margin="0,4,0,2" Foreground="{StaticResource Accent}" Visibility="Collapsed" ToolTip="Проверить незакоммиченные изменения с помощью Codex App Server" />
          <Button x:Name="RepositoryRemoteButton" Content="Открыть origin ↗" HorizontalAlignment="Left" Padding="2,3" Foreground="{StaticResource Accent}" Visibility="Collapsed" ToolTip="Открыть удалённый репозиторий" />
          <WrapPanel Margin="0,4,0,0">
            <Button x:Name="StageAllChangesButton" Content="В индекс всё" Padding="7,4" Margin="0,0,5,0" Visibility="Collapsed" ToolTip="Добавить все незастейдженные изменения в индекс Git" />
            <Button x:Name="UnstageAllChangesButton" Content="Снять индекс" Padding="7,4" Visibility="Collapsed" ToolTip="Убрать все изменения из индекса, сохранив файлы" />
          </WrapPanel>
          <StackPanel x:Name="RepositoryCommitPanel" Margin="0,5,0,0" Visibility="Collapsed">
            <TextBlock Text="СООБЩЕНИЕ КОММИТА" FontSize="9" Foreground="{StaticResource TextFaint}" Margin="0,3,0,4" />
            <DockPanel>
              <Button x:Name="CommitStagedButton" DockPanel.Dock="Right" Content="Коммит" Padding="8,5" Margin="5,0,0,0" ToolTip="Зафиксировать только staged-изменения" />
              <TextBox x:Name="CommitMessageInput" Height="30" Padding="7,4" Background="#1B2935" Foreground="#EAF3F6" BorderBrush="#435D6D" ToolTip="Сообщение коммита" />
            </DockPanel>
          </StackPanel>
          <Button x:Name="PushBranchButton" Content="Отправить ветку" HorizontalAlignment="Left" Padding="8,5" Margin="0,5,0,0" Visibility="Collapsed" ToolTip="Отправить текущую ветку в настроенный upstream без force-push" />
          <Button x:Name="CreatePullRequestButton" Content="Создать Pull Request" HorizontalAlignment="Left" Padding="8,5" Margin="0,4,0,0" Visibility="Collapsed" ToolTip="Создать Pull Request для уже отправленной GitHub-ветки через GitHub CLI" />
          <ScrollViewer MaxHeight="145" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="RepositoryChangesPanel" />
          </ScrollViewer>
        </StackPanel>
      </Border>
      <Grid Grid.Row="4">
        <Grid.RowDefinitions>
          <RowDefinition Height="28" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0">
          <Button x:Name="RefreshRepositoryButton" DockPanel.Dock="Right" Padding="5,2" Content="↻" FontSize="14" Foreground="{StaticResource TextMuted}" ToolTip="Обновить сведения о репозитории" />
          <TextBlock Text="ФАЙЛЫ" FontSize="9" Foreground="{StaticResource TextFaint}" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>
        <TreeView x:Name="FileTree" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMain}" />
      </Grid>
      <StackPanel Grid.Row="5" Margin="0,8,0,0">
        <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,9" />
        <TextBlock Text="Файлы и состояние Git выбранного проекта" FontSize="9" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" LineHeight="14" />
      </StackPanel>
    </Grid>
  </Border>
</Grid>
