<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Version>0.0.92</Version>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>..\Assets\codex-assistant.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>..\Properties\app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\**\*.cs"
             Exclude="..\Tests\**\*.cs;..\bin\**\*.cs;..\obj\**\*.cs;..\Build\**\*.cs;..\.git\**\*.cs" />
    <ApplicationDefinition Include="..\Application\App.xaml" Link="Application\App.xaml" />
    <Page Include="..\UI\Windows\MainWindow.xaml" Link="UI\Windows\MainWindow.xaml" />
    <InternalsVisibleTo Include="CodexGUI.Checks" />
    <Content Include="..\Views\WorkspaceView.xaml" Link="Views\WorkspaceView.xaml" TargetPath="Views\WorkspaceView.xaml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Scripts\Update-CodexGUI.ps1" Link="Update-CodexGUI.ps1" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="..\Views\WorkspaceView.xaml" LogicalName="CodexGUI.Views.WorkspaceView.xaml" />
    <EmbeddedResource Include="..\Scripts\Update-CodexGUI.ps1" LogicalName="CodexGUI.Update-CodexGUI.ps1" />
    <EmbeddedResource Include="..\Scripts\CodexCliWorker.ps1" LogicalName="CodexGUI.CodexCliWorker.ps1" />
    <Resource Include="..\Assets\codex-assistant.ico" Link="Assets\codex-assistant.ico" />
    <Content Include="..\Assets\codex-assistant.png" Link="Assets\codex-assistant.png" TargetPath="Assets\codex-assistant.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
